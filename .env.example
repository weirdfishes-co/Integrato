# --- Basics ------------------------------------------------------------------
# PORT is set automatically on Railway; locally 3000 is the default.
PORT=3000
# Public URL of the app — sign-in links are built on this.
# https:// automatically sets the Secure flag on the session cookie.
APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# --- Identity ----------------------------------------------------------------
# Name shown in the interface and in the sign-in email.
ASSISTANT_NAME=AI Assistant
# Language the assistant answers in, whatever language the user writes in.
# This rule is appended to the system prompt automatically.
ASSISTANT_LANGUAGE=English

# --- Database ----------------------------------------------------------------
# A local file in ./data; on Railway point this at the attached volume.
DATABASE_PATH=./data/app.db

# --- Knowledge base ----------------------------------------------------------
# Where instr.md and the context documents live. Leave empty to use the files in
# the repo (handy locally). On Railway the Docker image already points these at
# the volume (/data), because the admin edits them through the web page and the
# changes would otherwise disappear on every deploy. If the target location is
# still empty, the bundled files are copied there once.
CONTEXT_DIR=
INSTRUCTIONS_PATH=

# Root under which each assistant gets its own knowledge base, as
# <ASSISTANTS_DIR>/<slug>/instr.md and <ASSISTANTS_DIR>/<slug>/context/*.md.
# The image points this at the volume; keep it there or admin edits are lost.
ASSISTANTS_DIR=./data/assistants

# --- Model (OpenRouter) ------------------------------------------------------
# One key for every model OpenRouter offers: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Starting model, in OpenRouter's vendor/model form. An admin can change this on
# /admin without a redeploy; once they have, that choice wins over this value.
OPENROUTER_MODEL=anthropic/claude-opus-5
# low | medium | high | xhigh | max — higher = more thorough, slower, pricier.
# Only models that support reasoning act on this; the rest ignore it.
MODEL_EFFORT=high
MODEL_MAX_TOKENS=8000
# Optional: attributes traffic to your app on the openrouter.ai rankings.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# --- Access ------------------------------------------------------------------
# Comma-separated. These addresses always get admin rights at boot.
ADMIN_EMAILS=you@example.com
SESSION_DAYS=30
LOGIN_TOKEN_MINUTES=30

# --- Email --------------------------------------------------------------------
# Two ways to send the sign-in link; BREVO_API_KEY wins when both are set.
#
# Preferred on a hosting platform: Brevo's HTTP API runs over 443, which nothing
# blocks. Outbound SMTP ports are regularly dropped by the host or the provider,
# which shows up as a connection timeout. Key: Brevo > SMTP & API > API Keys.
BREVO_API_KEY=

# SMTP alternative. One of the two is required in production. Leave both empty
# locally and the sign-in link is written to the log instead of emailed — handy
# for signing in without a mail server.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Leave empty for STARTTLS on port 587; set to true for implicit TLS on 465.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AI Assistant <noreply@example.com>
