# --- Basics ------------------------------------------------------------------
# PORT is set automatically on Railway; locally 3000 is the default.
PORT=3000
# Public URL of the app — sign-in links are built on this.
# https:// automatically sets the Secure flag on the session cookie.
APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# --- Identity ----------------------------------------------------------------
# Name shown in the interface and in the sign-in email.
ASSISTANT_NAME=Unlimited Brain
# Language the assistant answers in, whatever language the user writes in.
# This rule is appended to the system prompt automatically.
ASSISTANT_LANGUAGE=English

# --- Database ----------------------------------------------------------------
# PostgreSQL connection string. Railway's Postgres plugin provides DATABASE_URL
# automatically; locally, run one in Docker:
#
#   docker run -d --name assistant-db -e POSTGRES_PASSWORD=dev \
#     -e POSTGRES_DB=assistant -p 5432:5432 postgres:17-alpine
#
DATABASE_URL=postgres://postgres:dev@localhost:5432/assistant

# --- Knowledge base ----------------------------------------------------------
# Root under which each assistant gets its own knowledge base, as
# <ASSISTANTS_DIR>/<slug>/instr.md and <ASSISTANTS_DIR>/<slug>/context/*.md.
# The image points this at the volume; keep it there or admin edits are lost.
ASSISTANTS_DIR=./data/assistants

# --- Model (OpenRouter) ------------------------------------------------------
# One key for every model OpenRouter offers: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Starting model, in OpenRouter's vendor/model form. An admin can change this on
# /admin without a redeploy; once they have, that choice wins over this value.
OPENROUTER_MODEL=anthropic/claude-opus-5
# low | medium | high | xhigh | max — higher = more thorough, slower, pricier.
# Only models that support reasoning act on this; the rest ignore it.
MODEL_EFFORT=high
MODEL_MAX_TOKENS=8000
# Optional: attributes traffic to your app on the openrouter.ai rankings.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# --- Access ------------------------------------------------------------------
# Comma-separated. These addresses always get admin rights at boot.
ADMIN_EMAILS=you@example.com
# Shared password for the addresses above. Admins sign in with their email plus
# this password on /login and are never emailed a link; everyone else still gets
# a magic link. Required — without it nobody can reach /admin. At least 12
# characters in production, where it is the only lock on the admin pages.
ADMIN_PASSWORD=change-this-password
SESSION_DAYS=30
# Only affects the magic links non-admin users receive.
LOGIN_TOKEN_MINUTES=30

# --- Email --------------------------------------------------------------------
# Brevo's HTTP API is the only way the app sends mail; it runs over 443, which
# nothing blocks. Required in production. Leave it empty locally and the sign-in
# link is written to the log instead — handy for signing in without a mail
# account. Key: Brevo > SMTP & API > API Keys.
BREVO_API_KEY=

# The sender Brevo shows. The address must be one Brevo has verified, or it
# refuses the send; left unset it becomes noreply@localhost, which it rejects.
MAIL_FROM=Unlimited Brain <noreply@example.com>

# --- Anonymization (optional) -------------------------------------------------
# Microsoft Presidio, for chatbots whose admin has switched on "Anonymize
# messages before sending them". Only the *analyzer* is needed — the app does
# the substitution itself:
#
#   docker run -d --name presidio -p 5002:3000 \
#     mcr.microsoft.com/presidio-analyzer:latest
#
# Leave it empty and the toggle stays disabled on the admin page. A chatbot that
# has it on refuses to send anything rather than sending it unprotected.
PRESIDIO_URL=
# The language the analyzer runs in. Not the chatbot's answer language: it picks
# the recognizers and the spaCy model, so the service must have it installed.
PRESIDIO_LANGUAGE=en
# Confidence floor, 0..1. Lower catches more and invents more.
PRESIDIO_SCORE_THRESHOLD=0.5
